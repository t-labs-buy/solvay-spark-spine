# Server settings for compose.yml. Copy to .env next to compose.yml and fill in.
# compose.yml sets DATABASE_URL, OLLAMA_HOST, NEO4J_URI and HINDSIGHT_URL itself.

# ── Required ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Password for the stack's Postgres (user "spark", database "solvay").
POSTGRES_PASSWORD=
# Password for the stack's Neo4j; empty switches the Cypher view off.
NEO4J_PASSWORD=

# ── Sign-in: change all of these on a server ──────────────────────────────
# Defaults are test/test and solvay/solvay. Without fixed secrets every
# restart signs everyone out. Generate secrets with: openssl rand -hex 32
# The sign-in guards the pages only; /api/* stays open (docs/deployment.md).
APP_USERNAME=
APP_PASSWORD=
APP_SECRET=
DEMO_USERNAME=
DEMO_PASSWORD=
DEMO_SECRET=

# ── Models (optional; defaults shown in the code) ─────────────────────────
RAG_EMBED_MODEL=bge-m3
RAG_EMBED_DIMENSION=1024
# RAG_ANSWER_MODEL=
# FITGAP_COPILOT_MODEL=
# CLAUDE_VLM_MODEL=
# OPENAI_API_KEY=
# OPENAI_VLM_MODEL=

# ── Langfuse tracing (optional; empty keys mean nothing is sent) ─────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=production

# ── Hindsight, the Evidence Agent's memory (optional; defaults shown) ─────
# It uses ANTHROPIC_API_KEY above. HINDSIGHT_MODEL files each investigation's
# findings; HINDSIGHT_REFLECT_MODEL answers "Ask memory" and must be fast.
# HINDSIGHT_MODEL=anthropic/claude-opus-5
# HINDSIGHT_REFLECT_MODEL=anthropic/claude-sonnet-5
# HINDSIGHT_TAG=latest

# ── compose.yml ───────────────────────────────────────────────────────────
# Image tag to run (default latest) and host port for the app (default 8000).
# TAG=latest
# APP_PORT=8000

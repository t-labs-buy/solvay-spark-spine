@startuml system-diagram
title Solvay Spark Spine AI — System Architecture

skinparam backgroundColor #FFFFFF
skinparam defaultTextAlignment center
skinparam shadowing false
skinparam roundcorner 8
skinparam nodesep 40
skinparam ranksep 70
skinparam rectangle {
  BorderColor #666666
}
skinparam cloud {
  BackgroundColor #333333
  FontColor #FFFFFF
  BorderColor #111111
}
skinparam database {
  BorderColor #666666
}
skinparam package {
  BorderColor #888888
  FontStyle bold
}
skinparam ArrowColor #444444
left to right direction

actor "Analyst" as User

package "Web UI — React SPA" {
  rectangle "Pages\nExtract · Ask · Quality · Graph\nEvidence · InsightLens · Fit-Gap Copilot" as UI
}

package "FastAPI — app.py · :8000" {
  rectangle "API routes\nREST · SSE streams" as API
  rectangle "Guardrails\nscope check (Haiku)\ncontact redaction" as GUARD
}

package "Ingestion" {
  rectangle "converter.py\nDocling · Tesseract · CV\n(optional vision model)" as CONV
  database "Markdown corpus\nsolvay-spark/*/markdown\nknowledge_base" as FILES
}

package "RAG system" {
  rectangle "rag.py · md_chunker\nindex · hybrid search · answer" as RAG
  rectangle "Ragas evaluation\nnine judges · Quality view" as EVAL
  rectangle "Ollama · :11434\nbge-m3 · 1024-d" as OLLAMA
}

package "Knowledge graph" {
  rectangle "knowledge_graph.py\nregex + ontology\nBFS · 2-hop" as KG
  database "knowledge_graph.json\nsource of truth" as KGJSON
}

package "Neo4j" {
  rectangle "kg_neo4j_load · kg_nl2cypher\nsync copy · NL → Cypher" as CYPHER
  database "Neo4j 5 Community · APOC\nBolt :7687 · Browser :7474" as NEO4J
}

package "Agents" {
  rectangle "Evidence Agent\nany question · scored claims" as EVID
  rectangle "InsightLens\nBPML scope → fit-gap register" as LENS
  rectangle "Fit-Gap Copilot\ncountry As-Is vs Global Template" as COPILOT
  rectangle "Agent runtime\ntools · verifier\nrun store · tracing" as TOOLS
}

package "Agent memory" {
  rectangle "Hindsight · :8888\nrecall · retain · reflect" as HINDSIGHT
}

package "PostgreSQL + pgvector · :5433" {
  database "docling\nrag_chunks · run history" as PG
  database "docling_session\none schema per upload" as PGSESS
}

cloud "Anthropic Claude\nanswers · agents · Cypher\njudge · scope" as CLAUDE
cloud "Langfuse Cloud\ntraces · scores" as LANGFUSE

User --> UI : HTTPS
UI --> API : REST · SSE
API --> GUARD
GUARD ..> UI

API --> CONV : upload · convert
CONV --> FILES : write .md

API --> RAG : embed · ask
API --> EVAL : score answer
RAG --> FILES : read .md
RAG --> OLLAMA : HTTP
RAG --> PG : SQL
RAG --> CLAUDE : stream answer
EVAL --> CLAUDE : judge
EVAL --> LANGFUSE : scores

API --> KG : rebuild · query
KG --> FILES : read .md
KG --> PG : passage layer
KG --> KGJSON : cache

KGJSON --> CYPHER : load whole
API --> CYPHER : cypher/generate
CYPHER --> CLAUDE : write Cypher
CYPHER --> NEO4J : Bolt · read tx

GUARD --> EVID : in scope
GUARD --> LENS : in scope
GUARD --> COPILOT : in scope
EVID --> CLAUDE : tool-use loop
LENS --> CLAUDE : tool-use loop
COPILOT --> CLAUDE : tool-use loop
EVID --> TOOLS
LENS --> TOOLS
COPILOT --> TOOLS
TOOLS --> RAG : rag.search
TOOLS --> KGJSON : traverse
TOOLS --> PGSESS : attachments
TOOLS --> PG : store run
TOOLS --> LANGFUSE : trace · scores
EVID --> HINDSIGHT : recall · retain
HINDSIGHT --> CLAUDE : fact extraction

note bottom of LANGFUSE
  Dark boxes = external services, and the
  only places data leaves the machine for.
  Ollama, Neo4j, Hindsight and PostgreSQL
  run locally on 127.0.0.1.
end note

@enduml
